# =====================================================
# ENVIRONMENT & CONFIGURATION FILES
# =====================================================
**/.env
**/.env.*
!.env.example
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local
**/*.env
**/config/local.json
**/config/secret.json
**/keys/
**/secrets/
**/credentials/

# =====================================================
# DEPENDENCIES
# =====================================================
**/node_modules/
**/.pnp/
.pnp.js
.npm/
.yarn/
yarn.lock
package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# =====================================================
# BUILD OUTPUTS
# =====================================================
**/dist/
**/build/
**/.next/
**/out/
**/.expo/
**/expo-build/
**/web-build/
**/.serverless/
**/.fusebox/
**/dll/

# =====================================================
# RUNTIME & LOGS
# =====================================================
**/logs/
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*
.pids
*.pid
*.seed
*.pid.lock

# =====================================================
# UPLOADS & USER CONTENT
# =====================================================
backend/uploads/*
!backend/uploads/.gitkeep
**/public/uploads/
**/storage/
**/media/

# =====================================================
# DATABASE & LOCAL STORAGE
# =====================================================
**/*.db
**/*.sqlite
**/*.sqlite3
**/*.db-journal
**/*.db-wal
**/*.db-shm
**/.mongodb/
**/.mongo/

# =====================================================
# TESTING
# =====================================================
**/coverage/
**/.nyc_output/
**/.jest/
**/.cache/
.parcel-cache/

# =====================================================
# OS & EDITOR
# =====================================================
# OS
**/.DS_Store
**/.DS_Store?
**/._*
**/.Spotlight-V100
**/.Trashes
**/ehthumbs.db
**/Thumbs.db
**/desktop.ini

# Editor
**/.vscode/
**/.vs/
**/.idea/
**/*.suo
**/*.ntvs*
**/*.njsproj
**/*.sln
**/*.sw?
**/*.code-workspace

# =====================================================
# REACT NATIVE / EXPO SPECIFIC
# =====================================================

frontend/ios/
frontend/.expo-shared/
frontend/.metro-cache/
frontend/.babel-cache/
frontend/web-build/
frontend/.webpack/
frontend/.react/

# =====================================================
# BACKEND SPECIFIC
# =====================================================
backend/.nyc_output/
backend/coverage/
backend/.cache/

# =====================================================
# MISC
# =====================================================
**/tmp/
**/temp/
**/.tern-port
**/.eslintcache
**/.stylelintcache
**/.cache/
**/.parcel-cache/
**/.rollup.cache/
**/.webpack.cache/

# =====================================================
# SECURITY (Extra protection)
# =====================================================
**/dump.rdb
**/redis.dump
**/session/*
**/private/
**/secure/
**/confidential/

# Firebase & Google OAuth credentials
**/google-services.json
**/GoogleService-Info.plist
**/firebase.json
**/*-firebase-adminsdk-*.json
**/eas.json

# =====================================================
# DOCKER & DEPLOYMENT
# =====================================================
# .dockerignore
.docker/
docker-compose.override.yml
**/.docker-volume/
**/docker-data/

# =====================================================
# DOCUMENTATION GENERATED
# =====================================================
**/docs/_build/
**/docs/_static/
**/docs/_templates/
