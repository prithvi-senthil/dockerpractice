# ==============================================================================
# Attendance App - Environment Configuration Template
# Copy this file to .env before starting containers:
#   cp .env.example .env
# ==============================================================================

# Database Configuration (MySQL)
DATABASE_HOST=mysql
DATABASE_PORT=3306
DATABASE_NAME=attendance_db
DATABASE_USER=attendance_user
DATABASE_PASSWORD=attendance_pass
MYSQL_ROOT_PASSWORD=rootpassword

# Redis Configuration (OTP Caching & Sessions)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Backend API Configuration
PORT=5000
NODE_ENV=production
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_chars_long

# Frontend Configuration
FRONTEND_URL=http://localhost:8081
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000/api

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=800231155792-ahm9cf1p82ho2sn0irlkr7u72pb6n149.apps.googleusercontent.com

# Email Service / Nodemailer (Optional)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
